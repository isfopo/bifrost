# Copy to .env and fill in the values your config.yaml references.
# Every *_env: key in config.yaml must appear here.
#
# Anything Bifrost reads from the environment starts with BIFROST_ so it
# can't collide with the same names exported for other tools (mail CLIs,
# CI runners, cron...). Keep that habit when inventing new *_env keys.

# Plane webhook signing secret (also set it in the Plane integration)
BIFROST_PLANE_WEBHOOK_SECRET=change-me

# CalDAV target credentials
BIFROST_CALDAV_USER=
BIFROST_CALDAV_PASS=

# SMTP relay credentials (kind: smtp services)
BIFROST_SMTP_USER=
BIFROST_SMTP_PASS=

# MQTT broker credentials (kind: mqtt services)
BIFROST_MQTT_USER=
BIFROST_MQTT_PASS=
